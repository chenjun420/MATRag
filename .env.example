# 复制为 .env 后填写。所有配置仅在此处维护, 代码零硬编码。

# ---- LLM (OpenAI 兼容 chat completions; MaaS) ----
MATRAG_LLM_BASE=https://llm-sy33nhdkv5053c8g.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
MATRAG_LLM_MODEL=qwen3.7-flash
MATRAG_LLM_API_KEY=sk-xxxx
# 表格重建提示词重、模型生成慢（实测 120s+/次），超时给足
MATRAG_LLM_TIMEOUT=300
# 关闭深度思考: 大表重建 121s→10s（thinking_level=low 反而 250s，勿用；qwen3.8-max 时代实测，qwen3.7-flash 沿用）
MATRAG_LLM_ENABLE_THINKING=false

# ---- Embedding (MaaS, OpenAI 兼容 /embeddings) ----
# MATRAG_EMBED_DIM 不设 = 启动探针实测（推荐；显式写死易造成索引/查询维度不一致）
MATRAG_EMBED_BASE=https://ark.cn-beijing.volces.com/api/plan/v3
MATRAG_EMBED_MODEL=doubao-embedding-vision
MATRAG_EMBED_API_KEY=your-embed-the-key-here
MATRAG_EMBED_BATCH_SIZE=10
MATRAG_EMBED_TIMEOUT=60

# ---- 解析 / 检索 / 服务 ----
MATRAG_PROFILE=dev
# 限流退避（Ark/DashScope 批量 embedding 会 429）
MATRAG_EMBED_MIN_INTERVAL=1.0
MATRAG_EMBED_MAX_RETRIES=6
# 检索是否默认走语义查询理解（understand: LLM 计划 + 接地校验）
MATRAG_RETRIEVE_AUTO_UNDERSTAND=true
MATRAG_ANSWER_MAX_ITEMS=12
MATRAG_ANSWER_MAX_CHARS=12000
MATRAG_PARSER_PROVIDER=local          # local | 后续外部解析器(质量评测通过后启用)
MATRAG_VECTOR_BACKEND=sqlite          # dev: sqlite | prod: pgvector
MATRAG_KEYWORD_BACKEND=fts5           # dev: fts5(jieba) | prod: pg-textsearch
MATRAG_GRAPH_BACKEND=file             # file(默认) | age(板上验证后启用)
MATRAG_GATEWAY_HOST=127.0.0.1
MATRAG_GATEWAY_PORT=8321
MATRAG_GATEWAY_API_KEY=               # fail-closed: 留空则拒绝服务

# ---- prod profile (PG17 @192.168.5.25) ----
MATRAG_PG_DSN=postgresql://matrag:CHANGE_ME@192.168.5.25:5432/matrag
