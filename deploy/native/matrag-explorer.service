[Unit]
Description=MATRag KG Explorer (semantica explore, 只读可视化)
Documentation=file:///opt/matrag/deploy/native/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=matrag
Group=matrag
WorkingDirectory=/opt/matrag
# .env 提供 SEMANTICA_API_KEY（explorer_serve 对非回环绑定强制鉴权, fail-closed）
EnvironmentFile=/opt/matrag/.env
Environment=PYTHONIOENCODING=utf-8
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/matrag/.venv/bin/python -m scripts.explorer_serve --host 0.0.0.0 --port 8899
Restart=always
RestartSec=10
TimeoutStopSec=15
# 日志: journalctl 之外额外落盘, 便于板卡侧排障
StandardOutput=append:/var/log/matrag/explorer.log
StandardError=append:/var/log/matrag/explorer.err

[Install]
WantedBy=multi-user.target
